# ===== SHU FAYLNI NUSXALAB .env QILING VA TO'LDIRING =====

# BotFather dan olingan token
BOT_TOKEN=123456:ABC...

# Bot egasi (admin) Telegram ID si
ADMIN_ID=123456789

# Ma'lumotlar bazasi yo'li
# Railway volume ishlatilsa: /data/pm_bot.db
DB_PATH=pm_bot.db

# MTProto (my.telegram.org -> API development tools) —
# PM (ko'rishlar) sanash va avto-o'chirish uchun.
# Bo'sh qoldirsangiz bot ishlayveradi, faqat PM sanash o'chiq bo'ladi.
API_ID=
API_HASH=
